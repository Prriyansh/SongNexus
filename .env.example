# Copy to .env.local. Never commit real secrets.
APP_URL=http://127.0.0.1:3000
# Development uses persistent PGlite when DATABASE_URL is empty.
# Production requires Postgres and an explicit encryption key.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=
CRON_SECRET=
# Set to off only when an external scheduler calls /api/integrations/cron.
SYNC_WORKER=on

SPOTIFY_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Paste the .p8 contents using literal \n between lines.
APPLE_MUSIC_PRIVATE_KEY=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Existing optional discovery services
GENIUS_ACCESS_TOKEN=
DISCOGS_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
SOUND_API_URL=
