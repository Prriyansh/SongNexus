# Coverage for `python -m pytest --cov`: every line and branch of the service and its data tools.
[run]
branch = True
source = .
omit =
    tests/*

[report]
show_missing = True
skip_covered = True
fail_under = 100
# Script entry points run only when the file is executed directly; their functions are tested.
exclude_also =
    if __name__ == .__main__.:
